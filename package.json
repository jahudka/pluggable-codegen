{
  "name": "pluggable-codegen",
  "version": "0.5.1",
  "homepage": "https://github.com/jahudka/pluggable-codegen",
  "bugs": {
    "url": "https://github.com/jahudka/pluggable-codegen/issues"
  },
  "license": "MIT",
  "maintainers": [
    {
      "name": "Eliška Daniela Kaderová",
      "email": "me@subsonic.cz",
      "url": "https://github.com/jahudka"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jahudka/pluggable-codegen.git"
  },
  "bin": {
    "pluggable-codegen": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "require": "./dist/index.d.cts",
        "import": "./dist/index.d.mts"
      },
      "default": {
        "require": "./dist/index.cjs",
        "import": "./dist/index.mjs"
      }
    },
    "./presets/*": {
      "types": {
        "require": "./dist/presets/*.d.cts",
        "import": "./dist/presets/*.d.mts"
      },
      "default": {
        "require": "./dist/presets/*.cjs",
        "import": "./dist/presets/*.mjs"
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "oxlint": "oxlint",
    "oxlint:fix": "oxlint --fix",
    "oxfmt": "oxfmt --check",
    "oxfmt:fix": "oxfmt --write",
    "lint": "pnpm run '/^(oxlint|oxfmt)$/'",
    "format": "pnpm run --sequential '/^(oxlint|oxfmt):fix$/'",
    "build": "tsc && tsdown",
    "publint": "publint"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.13.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@graphql-codegen/cli": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "yaml": "^2.9.1"
  },
  "peerDependenciesMeta": {
    "@graphql-codegen/cli": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.2"
}
