{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [".pnpm-store", "node_modules", "dist", "pnpm-lock.yaml"],
  "sortImports": {
    "ignoreCase": false,
    "newlinesBetween": false,
    "groups": [
      "type-builtin",
      "builtin",
      ["type-external", "external"],
      ["type-parent", "parent"],
      ["type-sibling", "type-index", "sibling", "index"],
      "unknown"
    ]
  }
}
